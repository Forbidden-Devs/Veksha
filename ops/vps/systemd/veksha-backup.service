[Unit]
Description=Veksha PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/veksha
Environment=VEKSHA_ROOT=/srv/veksha
Environment=VEKSHA_ENV_FILE=/srv/veksha/shared/.env.production
Environment=VEKSHA_BACKUP_DIR=/srv/veksha/backups
Environment=VEKSHA_BACKUP_RETENTION_DAYS=7
EnvironmentFile=-/etc/veksha/backup.env
ExecStartPre=-/srv/veksha/bin/backup-healthcheck.sh start
ExecStart=/srv/veksha/bin/backup-postgres.sh
ExecStartPost=-/srv/veksha/bin/backup-healthcheck.sh success
ExecStopPost=-/srv/veksha/bin/backup-healthcheck.sh stop
