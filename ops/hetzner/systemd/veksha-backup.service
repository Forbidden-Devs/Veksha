[Unit]
Description=Veksha PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/veksha
Environment=VEKSHA_ENV_FILE=/srv/veksha/.env.production
Environment=VEKSHA_BACKUP_DIR=/srv/veksha/backups
Environment=VEKSHA_BACKUP_RETENTION_DAYS=7
EnvironmentFile=-/etc/veksha/backup.env
ExecStart=/srv/veksha/ops/hetzner/backup-postgres.sh
