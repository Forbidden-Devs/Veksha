# Optional: LLM-backed features return a configuration error when this is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_SMART_MODEL=gpt-4.1

# Optional cost-control switch. This never selects a legacy implementation.
VEKSHA_PHRASE_MINING_ENABLED=1
VEKSHA_CORE_V2_GRAMMAR_MODEL=gpt-5.6-luna

# Optional local Google OAuth configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Local admin credentials. Change them if the stack is reachable by other users.
ADMIN_API_SECRET=local-admin-secret
ADMIN_DATABASE_SECRET=local-database-secret

# Only required for: docker compose --profile telegram up --build
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
VEKSHA_BOT_WEBHOOK_SECRET=local-telegram-webhook-secret

# Browser-facing backend URL, embedded into web/admin/extension builds.
VITE_BACKEND_URL=http://localhost:8000
