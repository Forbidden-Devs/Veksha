# Python
__pycache__/
*.pyc
.venv/
venv/

# Local ML models
veksha-backend/local_models/

# Runtime user data (per-user KB + sessions) — never commit user data
veksha-backend/data/*.json
!veksha-backend/data/i18n_*.json

# Runtime SQLite storage & cache
veksha-backend/data/*.db
veksha-backend/data/*.db-wal
veksha-backend/data/*.db-shm

# Node / build output
node_modules/
veksha-extension/dist/
veksha-web/dist/
veksha-web/public/source/
*.zip

# Generated by veksha-extension/scripts/sync-assets.mjs — do not commit
veksha-extension/public/source/
veksha-extension/public/icons/
veksha-extension/public/tesseract/

# Rendered brand-art intermediates (design/render.mjs)
veksha-extension/design/out/

# Old icon drafts
veksha-extension/icons/*_old.png
veksha-extension/icons/Untitled.png

# Env / secrets
.env
.env.*

# OS
.DS_Store
