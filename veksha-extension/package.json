{
  "name": "veksha-extension",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "predev": "npm run sync-assets",
    "dev": "node scripts/build.mjs chrome --watch --binary \"/Applications/Brave Browser.app/Contents/MacOS/Brave Browser\"",
    "predev:zen": "npm run sync-assets",
    "dev:zen": "node scripts/build.mjs firefox --watch --binary \"/Applications/Zen.app/Contents/MacOS/zen\"",
    "predev:firefox": "npm run sync-assets",
    "dev:firefox": "node scripts/build.mjs firefox --watch",
    "prebuild:chrome": "npm run sync-assets",
    "build:chrome": "vite build",
    "prebuild:firefox": "npm run sync-assets",
    "build:firefox": "node scripts/build.mjs firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.279",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-web-extension": "^4.2.0"
  }
}
