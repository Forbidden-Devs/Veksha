{
  "name": "veksha-extension",
  "version": "0.11.2",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "check:i18n": "python ../veksha-backend/scripts/manage_i18n.py check",
    "predev": "npm run predev:zen",
    "dev": "npm run dev:zen",
    "predev:chrome": "npm run sync-assets",
    "dev:chrome": "node scripts/build.mjs chrome --watch",
    "predev:brave": "npm run sync-assets",
    "dev:brave": "node scripts/build.mjs chrome --watch --app brave",
    "predev:zen": "npm run sync-assets",
    "dev:zen": "node scripts/build.mjs firefox --watch --app zen",
    "predev:firefox": "npm run sync-assets",
    "dev:firefox": "node scripts/build.mjs firefox --watch",
    "prebuild:chrome": "npm run sync-assets",
    "build:chrome": "vite build",
    "prebuild:firefox": "npm run sync-assets",
    "build:firefox": "node scripts/build.mjs firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "typecheck": "tsc --noEmit",
    "test:architecture": "node --test scripts/legacy-ui.test.mjs",
    "test:version": "node --test scripts/set-version.test.mjs",
    "version:check": "node scripts/set-version.mjs --check",
    "version:set": "node scripts/set-version.mjs",
    "check": "npm run typecheck && npm run check:i18n && npm run test:architecture && npm run test:version && npm run version:check && npm run build",
    "release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.279",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-web-extension": "^4.2.0"
  }
}
