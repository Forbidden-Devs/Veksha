# Copy to /srv/veksha/shared/.env.production on the VPS, fill every secret,
# then chmod 600. The release installer overrides both validation-only values.
# Keep values shell-safe: single-line letters, digits and URL-safe punctuation.

VEKSHA_REVISION=validation-only
VEKSHA_IMAGE_TAG=validation-only
VEKSHA_ENVIRONMENT=staging
VEKSHA_ACME_EMAIL=ops@example.com
VEKSHA_APP_DOMAIN=app.example.com
VEKSHA_API_DOMAIN=api.example.com
VEKSHA_CORS_ALLOW_ORIGINS=https://app.example.com,http://localhost:4173
COMPOSE_PROFILES=

# Use a long URL-safe value because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-url-safe-random-password
OPENAI_API_KEY=replace-me
SPEECH_BASE_URL=http://speech-platform:8080
SPEECH_SHARED_SECRET=replace-with-speech-platform-consumer-secret
SPEECH_DEFAULT_VOICE_ID=replace-with-platform-voice-id
SPEECH_TIMEOUT=60s
SPEECH_DOCKER_NETWORK=veksha-speech
GOOGLE_CLOUD_VISION_API_KEY=
VEKSHA_OCR_MIN_CONFIDENCE=0.55
VEKSHA_OCR_VISION_MODEL=gpt-5.6-luna

# Google login can remain disabled by leaving these empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/api/auth/google/callback

# Admin secrets must be long, random and different from each other.
ADMIN_API_SECRET=replace-with-random-admin-secret
ADMIN_DATABASE_SECRET=replace-with-different-random-database-secret

# Telegram is optional until the `telegram` Compose profile is enabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
VEKSHA_BOT_WEBHOOK_SECRET=

# Optional model overrides.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_SMART_MODEL=gpt-4.1
VEKSHA_PHRASE_MINING_ENABLED=1
VEKSHA_CORE_V2_LLM_TIMEOUT_SECONDS=30
VEKSHA_CORE_V2_TRANSLATION_MODEL=gpt-5.6-luna
VEKSHA_CORE_V2_PHRASE_MINING_MODEL=gpt-5.6-luna
VEKSHA_CORE_V2_DICTIONARY_MODEL=gpt-5.6-luna
VEKSHA_CORE_V2_SENTENCE_MINING_MODEL=gpt-5.6-luna
VEKSHA_CORE_V2_GRAMMAR_MODEL=gpt-5.6-luna
VEKSHA_CORE_V2_SUBTITLES_MODEL=gpt-5.6-luna
VEKSHA_CORE_V2_I18N_MODEL=gpt-5.6-luna
VEKSHA_CORE_V2_TRAINING_MODEL=gpt-5.6-terra
VEKSHA_CORE_V2_LESSON_MODEL=gpt-5.6-terra
VEKSHA_CORE_V2_READING_MODEL=gpt-5.6-luna
