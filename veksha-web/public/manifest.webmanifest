{
  "name": "Veksha",
  "short_name": "Veksha",
  "description": "Learn vocabulary from what you read — spaced repetition without manual flashcards.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "background_color": "#f6f2e9",
  "theme_color": "#a95124",
